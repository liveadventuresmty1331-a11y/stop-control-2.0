# ========================================================
# STOPControl 2.0 — Variables de Entorno de Configuración
# ========================================================

# Cadena de conexión a base de datos PostgreSQL
# Compatible con Neon PostgreSQL, Supabase, Vercel Postgres o PostgreSQL local
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stopcontrol_db?schema=public"

# Secreto para firma de JWT y sesiones seguras en cookies
AUTH_SECRET="stopcontrol-super-secure-jwt-secret-key-32chars"

# URL base de la aplicación (en local o Vercel)
NEXTAUTH_URL="http://localhost:3000"

# Entorno de ejecución
NODE_ENV="development"
